{
  "name": "fast-balance",
  "version": "1.0.7",
  "description": "Blazing fast chemical equation balancer - handles complex formulas, redox, charges, hydrates, all arrow styles.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "rolldown --config rolldown.config.js",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:es6": "es-check es6 dist/index.js --module && es-check es6 dist/index.cjs --module",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "chemistry",
    "chemical",
    "equation",
    "balancer",
    "balance",
    "balancing",
    "chemical-equation",
    "chemical-equation-balancer",
    "equation-balancer",
    "reaction",
    "reactions",
    "reaction-balancer",
    "stoichiometry",
    "stoichiometric",
    "stoichiometric-coefficient",
    "coefficient",
    "redox",
    "redox-reaction",
    "half-reaction",
    "ionic",
    "ionic-compound",
    "ionic-charge",
    "charge",
    "charge-balance",
    "oxidation",
    "oxidation-number",
    "electron",
    "electrons",
    "hydrate",
    "hydrates",
    "mineral",
    "mineralogy",
    "analytical-chemistry",
    "chemistry-tool",
    "chemistry-library",
    "chemistry-parser",
    "formula",
    "formulas",
    "chemical-formula",
    "formula-parser",
    "chemical-parser",
    "parse",
    "parsing",
    "linear-algebra",
    "nullspace",
    "rational-arithmetic",
    "exact-arithmetic",
    "integer-coefficients",
    "javascript",
    "typescript",
    "library",
    "node",
    "esm",
    "cjs",
    "commonjs",
    "dual-module",
    "no-floating-point",
    "education",
    "homework",
    "chem",
    "chemistry-education"
  ],
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.js.map",
    "dist/index.d.ts.map",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "es-check": "^9.6.4",
    "esbuild": "^0.28.1",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "chemparse": "^1.0.3"
  },
  "overrides": {
    "vite": "7.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richie-rich90454/fast-balance.git"
  }
}
