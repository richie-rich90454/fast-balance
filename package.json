{
  "name": "fast-balance",
  "version": "1.0.5",
  "description": "Blazing fast chemical equation balancer - handles complex formulas, redox, charges, hydrates, all arrow styles.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --minify --target=es6 --format=esm --outfile=dist/index.js",
    "build:cjs": "esbuild src/index.ts --bundle --minify --target=es6 --format=cjs --outfile=dist/index.cjs",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:es6": "es-check es6 dist/index.js --module && es-check es6 dist/index.cjs --module"
  },
  "keywords": [
    "chemistry",
    "chemical",
    "equation",
    "balancer",
    "balance",
    "balancing",
    "chemical-equation",
    "chemical-equation-balancer",
    "equation-balancer",
    "reaction",
    "reactions",
    "reaction-balancer",
    "stoichiometry",
    "stoichiometric",
    "stoichiometric-coefficient",
    "coefficient",
    "redox",
    "redox-reaction",
    "half-reaction",
    "ionic",
    "ionic-compound",
    "ionic-charge",
    "charge",
    "charge-balance",
    "oxidation",
    "oxidation-number",
    "electron",
    "electrons",
    "hydrate",
    "hydrates",
    "mineral",
    "mineralogy",
    "analytical-chemistry",
    "chemistry-tool",
    "chemistry-library",
    "chemistry-parser",
    "formula",
    "formulas",
    "chemical-formula",
    "formula-parser",
    "chemical-parser",
    "parse",
    "parsing",
    "linear-algebra",
    "nullspace",
    "rational-arithmetic",
    "exact-arithmetic",
    "integer-coefficients",
    "javascript",
    "typescript",
    "library",
    "node",
    "esm",
    "cjs",
    "commonjs",
    "dual-module",
    "no-floating-point",
    "education",
    "homework",
    "chem",
    "chemistry-education"
  ],
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.js.map",
    "dist/index.d.ts.map",
    "README.md"
  ],
  "license": "MIT",
  "devDependencies": {
    "es-check": "^9.6.4",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "chemparse": "^1.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richie-rich90454/fast-balance.git"
  }
}