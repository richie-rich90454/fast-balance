{
    "name": "fast-balance",
    "version": "1.1.0",
    "description": "Blazing fast chemical equation balancer - exact rational arithmetic, complex formulas, redox, charges, hydrates, isotopes, nuclear mode.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsdown",
        "prepublishOnly": "npm run test && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:syntax": "es-check es2020 dist/index.mjs --module && es-check es2020 dist/index.cjs",
        "bench": "vitest bench",
        "format": "oxfmt"
    },
    "keywords": [
        "chemistry",
        "chemical",
        "equation",
        "balancer",
        "balance",
        "balancing",
        "chemical-equation",
        "chemical-equation-balancer",
        "equation-balancer",
        "reaction",
        "reactions",
        "reaction-balancer",
        "stoichiometry",
        "stoichiometric",
        "stoichiometric-coefficient",
        "coefficient",
        "redox",
        "redox-reaction",
        "half-reaction",
        "ionic",
        "ionic-compound",
        "ionic-charge",
        "charge",
        "charge-balance",
        "oxidation",
        "oxidation-number",
        "electron",
        "electrons",
        "isotope",
        "isotopes",
        "nuclear",
        "hydrate",
        "hydrates",
        "mineral",
        "mineralogy",
        "analytical-chemistry",
        "chemistry-tool",
        "chemistry-library",
        "chemistry-parser",
        "formula",
        "formulas",
        "chemical-formula",
        "formula-parser",
        "chemical-parser",
        "parse",
        "parsing",
        "linear-algebra",
        "nullspace",
        "rational-arithmetic",
        "exact-arithmetic",
        "integer-coefficients",
        "javascript",
        "typescript",
        "library",
        "node",
        "esm",
        "cjs",
        "commonjs",
        "dual-module",
        "no-floating-point",
        "education",
        "homework",
        "chem",
        "chemistry-education"
    ],
    "files": [
        "dist"
    ],
    "license": "MIT",
    "devDependencies": {
        "es-check": "^9.7.2",
        "oxfmt": "^0.68.0",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/richie-rich90454/fast-balance.git"
    }
}
